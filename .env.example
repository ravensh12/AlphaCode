# Copy to .env.local and fill in your Supabase project values.
# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Use the client-safe key: the "anon" key, or the newer "sb_publishable_..." key.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Meshy AI (asset generation pipeline: scripts/meshy-*.mjs). Server-side only.
MESHY_API_KEY=

# ----------------------------------------------------------------- AI tutor --
# The tutor picks its transport automatically:
#   VITE_TUTOR_API_KEY set  -> browser calls the gateway directly (streaming)
#   otherwise               -> browser calls the `ai-tutor` edge function
# The two Supabase vars above are therefore all a DEPLOYMENT needs.
#
# ⚠️ NEVER set VITE_TUTOR_API_KEY on a public host (Vercel etc.): VITE_ vars are
# baked into the client bundle at build time, so the key would be readable by
# anyone who opens devtools. Local `.env.local` only.
#VITE_TUTOR_BASE_URL=https://gateway.truefoundry.ai
#VITE_TUTOR_MODEL=openai-group/gpt-5.4-mini
#VITE_TUTOR_API_KEY=

# Deployment path — these are SUPABASE FUNCTION SECRETS, not VITE vars. They
# live only in Supabase and are never part of any build:
#   supabase secrets set AI_TUTOR_API_KEY=...
#   supabase secrets set AI_TUTOR_BASE_URL=https://gateway.truefoundry.ai
#   supabase secrets set AI_TUTOR_MODEL=openai-group/gpt-5.4-mini
# Defaults: BASE_URL https://api.openai.com, MODEL gpt-4o-mini. The legacy name
# OPENAI_API_KEY is still honoured. Optional: AI_TUTOR_TEMPERATURE,
# AI_TUTOR_MAX_TOKENS (omitted by default — some models reject them).
